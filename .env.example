# ============================================================
#  Copy this file to ".env" and fill in your values:
#     cp .env.example .env
# ============================================================

# --- LLM selection (litellm model string) ---
# Local Ollama (default): no rate limits, free. Requires `ollama pull qwen2.5:7b`.
LLM_MODEL=ollama_chat/qwen2.5:7b
OLLAMA_BASE_URL=http://host.docker.internal:11434
PHASE_PAUSE_SECONDS=0

# --- Groq fallback (only used if LLM_MODEL starts with groq/) ---
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_free_key_here

# --- PostgreSQL (used by the Docker db service) ---
POSTGRES_USER=sma
POSTGRES_PASSWORD=sma_pass
POSTGRES_DB=social_agency

# NOTE: DATABASE_URL is set automatically inside docker-compose.
# For running the app OUTSIDE Docker, uncomment and use localhost:
# DATABASE_URL=postgresql+psycopg2://sma:sma_pass@localhost:5432/social_agency
